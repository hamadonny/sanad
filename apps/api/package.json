{
  "name": "@sanad/api",
  "version": "0.0.0",
  "private": true,
  "description": "Sanad backend API (NestJS).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@sanad/config": "workspace:*",
    "@sanad/core": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  }
}
