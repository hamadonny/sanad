{
  "name": "@sanad/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Sanad mobile app (Expo / React Native, iOS + Android).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && jest",
    "doctor": "expo-doctor",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "web": "expo start --web",
    "test:components": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sanad/api-client": "workspace:*",
    "@sanad/config": "workspace:*",
    "@sanad/core": "workspace:*",
    "@sanad/i18n": "workspace:*",
    "@sanad/ui-tokens": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "i18next": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^18.0.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.0.0"
  }
}
