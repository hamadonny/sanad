{
  "expo": {
    "name": "Sanad",
    "slug": "sanad",
    "scheme": "sanad",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kw.sanad.app",
      "infoPlist": {
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kw.sanad.app",
      "adaptiveIcon": {
        "backgroundColor": "#D7EFEC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم سند Face ID لقفل التطبيق وتأكيد المدفوعات. Sanad uses Face ID to lock the app and confirm payments."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "يحتاج سند الكاميرا لتصوير بطاقتك المدنية وصورة شخصية للتحقق. Sanad needs the camera to photograph your Civil ID and a selfie for verification.",
          "photosPermission": "لاختيار صورة البطاقة المدنية. To choose a Civil ID photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F5E5A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
