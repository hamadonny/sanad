{
  "name": "@sanad/core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, framework-free financial engine for Sanad circles (no I/O).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@sanad/config": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
