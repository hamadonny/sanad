  "info": {
    "title": "Sanad API",
    "description": "Guaranteed digital jamiya. Money is integer fils as strings (1 KWD = 1,000 fils).",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+96550000001"
          },
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ]
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+96550000001"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "ar",
              "en"
            ]
          }
        },
        "required": [
          "language"
        ]
      },
      "KycSubmissionDto": {
        "type": "object",
        "properties": {
          "fullNameAr": {
            "type": "string"
          },
          "fullNameEn": {
            "type": "string"
          },
          "civilIdNumber": {
            "type": "string",
            "example": "290010112345"
          },
          "nationality": {
            "type": "string",
            "example": "KW"
          },
          "dateOfBirth": {
            "type": "string",
            "example": "1990-01-01"
          },
          "civilIdExpiry": {
            "type": "string",
            "example": "2030-01-01"
          },
          "address": {
            "type": "string"
          },
          "employer": {
            "type": "string"
          },
          "incomeBand": {
            "type": "string"
          }
        },
        "required": [
          "fullNameAr",
          "fullNameEn",
          "civilIdNumber",
          "nationality",
          "dateOfBirth",
          "civilIdExpiry",
          "address"
        ]
      },
      "SignContractDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          }
        },
        "required": [
          "version"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "pushToken": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          }
        },
        "required": [
          "pushToken",
          "platform"
        ]
      },
      "TicketDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "subject",
          "body"
        ]
      },
      "JoinQueueDto": {
        "type": "object",
        "properties": {
          "monthlyKwd": {
            "type": "number",
            "example": 100,
            "description": "Monthly amount in whole KWD"
          }
        },
        "required": [
          "monthlyKwd"
        ]
      },
      "BidDto": {
        "type": "object",
        "properties": {
          "spot": {
            "type": "number"
          },
          "amountFils": {
            "type": "string",
            "example": "45000",
            "description": "Bid in fils"
          }
        },
        "required": [
          "spot",
          "amountFils"
        ]
      },
      "IntentDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "CONTRIBUTION",
              "REPLACEMENT"
            ]
          },
          "circleId": {
            "type": "string"
          },
          "month": {
            "type": "number",
            "description": "Required for CONTRIBUTION"
          },
          "spot": {
            "type": "number",
            "description": "Required for REPLACEMENT"
          }
        },
        "required": [
          "purpose",
          "circleId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "email",
          "password",
          "totp"
        ]
      },
      "OptionalReasonDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "ReasonDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ConfigDto": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "config"
        ]
      },
      "CapitalDto": {
        "type": "object",
        "properties": {
          "amountFils": {
            "type": "string",
            "example": "5000000",
            "description": "fils"
          },
          "reference": {
            "type": "string",
            "example": "launch-reserve-2027"
          }
        },
        "required": [
          "amountFils",
          "reference"
        ]
      },
      "LegalUpdateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "SENT_TO_LAWYER",
              "FILED",
              "JUDGMENT",
              "RECOVERING",
              "CLOSED"
            ]
          },
          "note": {
            "type": "string"
          },
          "recoveredFils": {
            "type": "string",
            "description": "recovered amount in fils"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
