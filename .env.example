# Copy to .env and adjust. Never commit real secrets.

# --- API ---
NODE_ENV=development
API_PORT=3000
TZ_BUSINESS=Asia/Kuwait
DATABASE_URL=postgresql://sanad:sanad@localhost:5432/sanad?schema=public
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025

# Providers: only "mock" is allowed until Phase 7 (written go-ahead required).
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock
SMS_PROVIDER=mock
PUSH_PROVIDER=mock

# --- Admin ---
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mobile (Expo reads EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
