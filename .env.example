# Copy to .env and adjust. Never commit real secrets.

# --- API ---
NODE_ENV=development
API_PORT=3000
TZ_BUSINESS=Asia/Kuwait
DATABASE_URL=postgresql://sanad:sanad@localhost:5433/sanad
REDIS_URL=redis://localhost:6380
SMTP_HOST=localhost
SMTP_PORT=1026

JOBS_ENABLED=true            # run the scheduler (needs Redis)
JOBS_TICK_SECONDS=60
# Secrets: dev defaults are used when empty; REQUIRED in production.
JWT_SECRET=
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=              # base64 of 32 random bytes
BLIND_INDEX_KEY=             # base64 of 32 random bytes
PAYMENT_WEBHOOK_SECRET=
STORAGE_DIR=./.data/storage

# Providers: only mocks exist until Phase 7 (written go-ahead required).
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock       # mock | manual (admin review queue)
MOCK_KYC_AUTO_APPROVE=true
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
DEV_ENDPOINTS=true           # /dev/* and mock payment confirmation; always off in production
# Dev only: these phones sign in without an SMS code (comma-separated). Ignored in production.
DEV_LOGIN_PHONES=+96599302447
MIGRATE_ON_START=true        # apply DB migrations when the API starts (dev only)
THROTTLE_PER_MINUTE=300      # requests per signed-in session (or per IP when signed out)
ALERT_WEBHOOK_URL=           # optional Slack/Teams/Discord webhook for new API errors
# Store review account (works in production too). Leave empty until you submit to the stores.
REVIEW_PHONE=
REVIEW_CODE=

# --- Admin ---
ADMIN_PORT=3001
# Where the dashboard's server reaches the API (server-side only).
ADMIN_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_PHONE=+965 9930 2447
NEXT_PUBLIC_SUPPORT_EMAIL=support@sanad.kw
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mobile (Expo reads EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPPORT_WHATSAPP=96599302447
EXPO_PUBLIC_SUPPORT_PHONE=+96599302447
# Browsers allowed to call the API in production (comma-separated). Dev allows any.
CORS_ORIGINS=
