# Copy to .env and adjust. Never commit real secrets.

# --- API ---
NODE_ENV=development
API_PORT=3000
TZ_BUSINESS=Asia/Kuwait
DATABASE_URL=postgresql://sanad:sanad@localhost:5432/sanad
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025

JOBS_ENABLED=true            # run the scheduler (needs Redis)
JOBS_TICK_SECONDS=60
# Secrets: dev defaults are used when empty; REQUIRED in production.
JWT_SECRET=
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=              # base64 of 32 random bytes
BLIND_INDEX_KEY=             # base64 of 32 random bytes
PAYMENT_WEBHOOK_SECRET=
STORAGE_DIR=./.data/storage

# Providers: only mocks exist until Phase 7 (written go-ahead required).
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock       # mock | manual (admin review queue)
MOCK_KYC_AUTO_APPROVE=true
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
DEV_ENDPOINTS=true           # /dev/* and mock payment confirmation; always off in production

# --- Admin ---
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Mobile (Expo reads EXPO_PUBLIC_*) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPPORT_WHATSAPP=96500000000
EXPO_PUBLIC_SUPPORT_PHONE=+96500000000
# Browsers allowed to call the API in production (comma-separated). Dev allows any.
CORS_ORIGINS=
